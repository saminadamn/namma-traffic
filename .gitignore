# ── Python / Backend ───────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
venv/
.venv/
env/
.env
*.env

# Alembic — keep migrations, not __pycache__ inside them
backend/alembic/__pycache__/

# ── Frontend / Node ────────────────────────────────────────────
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env.local
frontend/.env.production
frontend/css.d.ts
frontend/tsconfig.tsbuildinfo

# ── OS / Editor ────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/settings.json
.idea/
.claude/

# ── CatBoost training artifacts (keep actual .pkl models) ───────
backend/catboost_info/
*.cbm
# ...but the two served models under ml_models/ ARE tracked. Without this
# negation a retrained closure_model.cbm / priority_model.cbm is silently
# skipped by `git add` and never ships.
!backend/ml_models/*.cbm

# ── Logs ───────────────────────────────────────────────────────
*.log
uvicorn.log

# ── OSMnx graph cache (large binary, regenerated on first run) ──
backend/cache/
*.graphml
